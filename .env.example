# Public browser address, also when gateway itself runs over HTTP.
PUBLIC_URL=https://dsh.example.com/
# Set this to the exact release documented as tested in README.md.
DSH_VERSION=0.2.1-rc.5
AUTH_USERNAME=token
# Dedicated host directory; NEVER use your real home directory.
DSH_HOME_PATH=./data/home
# Match the owner of the dedicated home; changing these requires image rebuild.
RDSH_UID=1000
RDSH_GID=1000
# Only for compose.https.yml:
ACME_EMAIL=admin@example.com
# Only for compose.proxy-host.yml:
GATEWAY_HTTP_PORT=8080
# Only for compose.proxy-network.yml; create/manage this network with your proxy.
PROXY_NETWORK=reverse-proxy
# Optional comma-separated trusted reverse proxy CIDRs, not arbitrary clients.
TRUSTED_PROXIES=
