# Public browser address, also when gateway itself runs over HTTP.
PUBLIC_URL=https://dsh.example.com/
# Let's Encrypt contact. DNS must point to this server; ports 80/443 must be free.
ACME_EMAIL=admin@example.com
# Set this to the exact release documented as tested in README.md.
DSH_VERSION=0.2.1-rc.5
AUTH_USERNAME=token
# Generate with: docker compose run --rm --no-deps gateway hash-password
# Keep the bcrypt hash in SINGLE quotes so Compose preserves every dollar sign.
AUTH_PASSWORD_HASH=''
# Published multi-architecture images. Pin a release tag or digest if desired.
RDSH_DSH_IMAGE=ghcr.io/reansn0w/rdsh-dsh:latest
RDSH_GATEWAY_IMAGE=ghcr.io/reansn0w/rdsh-gateway:latest
# Dedicated host directory; NEVER use your real home directory.
DSH_HOME_PATH=./data/home
# Optional comma-separated trusted reverse proxy CIDRs, not arbitrary clients.
TRUSTED_PROXIES=
